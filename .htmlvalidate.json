{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "void-style": "off",
    "prefer-native-element": "off",
    "element-permitted-content": ["error", { "exclude": ["a"] }],
    "require-sri": "off",
    "no-trailing-whitespace": "off",
    "long-title": "off"
  }
}
